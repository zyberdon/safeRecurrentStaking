{
  "name": "safe-recurrent-staking",
  "version": "1.0.0",
  "description": "Automated bi-weekly Safenet Aegis SAFE staking rewards claimer for Safe accounts, with adjustable operator fee routing and auto-restaking.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-roles": "node dist/setup-roles.js",
    "parity": "node dist/parity-check.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "zodiac-roles-sdk": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
